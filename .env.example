# Copiar este archivo como .env y completar los valores. El .env NO se sube al repositorio.
# Hoy (Entrega 1) ningún contenedor los usa todavía; quedan definidos para el backend.

# Usuarios
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_TTL_MINUTES=120

# MySQL: una instancia, una base y un usuario por servicio (Usuarios, Inventario, Pedidos)
MYSQL_ROOT_PASSWORD=
USUARIOS_DB_PASSWORD=
INVENTARIO_DB_PASSWORD=
PEDIDOS_DB_PASSWORD=

# MongoDB: una instancia, una base y un usuario por servicio (Catálogo, Notificaciones)
MONGO_ROOT_PASSWORD=
CATALOGO_DB_PASSWORD=
NOTIFICACIONES_DB_PASSWORD=

# RabbitMQ
RABBITMQ_USER=ghostkitchen
RABBITMQ_PASSWORD=

# Notificaciones: SMTP (en local, Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Capacidad publicada: claves de los grupos consumidores, separadas por coma
PUBLIC_API_KEYS=

# Capacidad consumida (grupo proveedor, a definir)
PROVIDER_BASE_URL=
PROVIDER_API_KEY=

# Grafana
GRAFANA_ADMIN_PASSWORD=
